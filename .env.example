# Conexión DIRECTA (puerto 5432). Medida como la más rápida desde Latam (el pooler
# de Supabase tuvo peor ruta). connection_limit=1 reúsa una conexión tibia y evita
# los "cold connects" de ~3s cuando se disparan queries en paralelo.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?connection_limit=1"
# Igual a DATABASE_URL pero sin params, para migraciones/seed (prisma migrate/db push).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
# Credenciales del Basic Auth (middleware.ts). En un entorno que NO sea local son
# obligatorias: sin ellas la app responde 503 a todo en vez de caer en un default.
# Tampoco se acepta "admin123" fuera de local — es una clave publicada, no un secreto.
ADMIN_USER="admin"
ADMIN_PASSWORD="changeme"

# Declara el entorno como local. Es lo UNICO que habilita los valores por defecto
# admin/admin123 del middleware. En Heroku no se define: asi, un dyno al que le
# falten las config vars falla cerrado en lugar de quedar abierto con la clave
# que esta escrita en este archivo.
APP_ENV="local"

S3_ACCESS_KEY_ID="aa"
S3_SECRET_ACCESS_KEY="aaa"
S3_BUCKET_NAME="bajaj-imagenes"
S3_ENDPOINT_URL="https://PROJECT.storage.supabase.co/storage/v1/s3"
S3_REGION="us-west-2"