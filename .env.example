# Base de datos LOCAL: copia de producción en Docker (pnpm db:up; se recarga con pnpm db:pull-prod).
# Producción (Lightsail) es el Postgres de la propia máquina, privado, y su conexión vive en
# /etc/bajaj/app.env, no acá: nada de lo que corras desde tu PC la toca por accidente.
DATABASE_URL="postgresql://bajaj:bajaj123@localhost:5432/bajaj_repuestos"
# Igual a DATABASE_URL, para scripts y migraciones (pnpm db:migrar).
DIRECT_URL="postgresql://bajaj:bajaj123@localhost:5432/bajaj_repuestos"
# Para tocar PRODUCCIÓN a propósito: correr el script en el servidor, o abrir un túnel
#   ssh -N -L 15432:localhost:5432 ubuntu@motokira      (por Tailscale)
# y apuntar DATABASE_URL a localhost:15432 con la clave de /etc/bajaj/app.env. OJO: con el túnel
# abierto, lo que escribe (prices:99rpm --apply, materialize, cross-ref…) escribe en PRODUCCIÓN.
# Credenciales del Basic Auth (proxy.ts). En un entorno que NO sea local son
# obligatorias: sin ellas la app responde 503 a todo en vez de caer en un default.
# Tampoco se acepta "admin123" fuera de local — es una clave publicada, no un secreto.
ADMIN_USER="admin"
ADMIN_PASSWORD="changeme"

# Declara el entorno como local. Es lo UNICO que habilita los valores por defecto
# admin/admin123 de proxy.ts. En el servidor no se define (/etc/bajaj/app.env): asi, si
# le falta una variable falla cerrado en lugar de quedar abierto con la clave que esta
# escrita en este archivo.
APP_ENV="local"

# Ship24 (seguimiento automático de los trackings de las cajas). Vacía = apagado: los
# números quedan solo anotados. Se crea en el dashboard de Ship24 → Developers → API Keys.
SHIP24_API_KEY=""

# One Way Cargo (Miami → Caracas): la cuenta de onewaycargo.net, para seguir los códigos MT-/CON-…
# del tramo Venezuela (lib/oneway.ts). Vacías = apagado.
ONEWAY_EMAIL=""
ONEWAY_PASSWORD=""

# Imágenes: bucket de Lightsail (lectura pública). Solo las usan los scripts de imágenes, no las páginas.
# La access key es la de motokira-images (la de motokira-backups es otra y no sirve acá).
S3_ACCESS_KEY_ID="AKIA…"
S3_SECRET_ACCESS_KEY="…"
S3_BUCKET_NAME="motokira-images"
# Vacío con AWS/Lightsail; solo se define para un S3 de terceros (ahí también va forcePathStyle).
S3_ENDPOINT_URL=""
S3_REGION="us-east-1"
# Prefijo público de los objetos (sin barra final). Los scripts de imágenes lo exigen: no se deriva del endpoint.
S3_PUBLIC_BASE_URL="https://motokira-images.s3.us-east-1.amazonaws.com"