    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
