// Registro de los .sql de prisma/manual ya aplicados a esta base. Lo escribe scripts/migrar.ts
// (pnpm db:migrar) y la app no lo lee; está declarado acá para que `prisma migrate diff` no lo
// tome por una tabla sobrante. `checksum` detecta un archivo editado después de aplicarse.
model MigracionManual {
  nombre     String   @id
  checksum   String
  aplicadaAt DateTime @default(now())
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               Int       @id @default(autoincrement())
  bajajCode        String?
  sourceUrl        String?
  imageUrl         String? // imagen de la pieza, si hay (las del ensamble viven en Ensamble.imageUrl)
  nameEs           String
  nameEn           String?
  description      String?
  notes            String?
  // Motos a las que le sirve la pieza, como texto: las etiquetas separadas por comas
  // ("Pulsar N250 Dual ABS 2022 23, Pulsar N160 Dual ABS 2022 23"). Un ensamble lleva
  // UNA — esa es su identidad, y es lo único que distingue dos conjuntos homónimos de
  // motos distintas. Una pieza suelta lleva todas las que la usan, y de ahí sale la
  // compatibilidad cruzada.
  //
  // Hubo un intento de tiparlo con el enum MotoModel (`Product.models`) y se revirtió:
  // la columna se dropeó de la DB y el texto quedó como única fuente. El enum obligaba a
  // una migración por cada moto nueva, y el catálogo crece — la Boxer BM150 entró después
  // y fue justamente lo que lo rompió. `MotoModel` sigue vivo pero solo para
  // ScrapedProduct.model, donde el valor lo fija el scrape y no la carga a mano.
  //
  // lib/modelo.ts traduce este texto a las motos tipadas para mostrarlo (`toModelIds`),
  // así la presentación sigue siendo consistente sin atar la columna al enum.
  compatibleModels String?
  weightGrams      Int?
  dimL             Float?
  dimA             Float?
  dimH             Float?
  priceInr         Int?
  landedCostUsd    Decimal?  @db.Decimal(10, 2)
  margin           Float?
  price            Decimal   @db.Decimal(10, 2)
  // Precio fijado a mano: cuando es true, los recálculos (carga de medidas, costos)
  // NO pisan `price`; solo actualizan landedCostUsd y ajustan el margen para reflejar
  // el precio elegido.
  priceLocked      Boolean   @default(false)
  // Descontinuado de FÁBRICA. Bajaj dejó de producir la pieza, así que no la consigue
  // ningún proveedor: no es una falta de stock de uno, es que no existe para nadie. Por eso
  // vive acá y no en SupplierPrice — un precio cargado de antes no la vuelve comprable.
  //
  // Fecha y no booleano: registra CUÁNDO nos enteramos, que es lo que permite releer un
  // presupuesto viejo ("cuando se lo cotizamos todavía se conseguía"). NULL = vigente.
  discontinuedAt   DateTime?
  stock            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // En qué ensambles aparece esta pieza (una fila por subgrupo).
  assemblies     EnsambleComponente[]
  pedidoItems    PedidoItem[]
  // Partes scrapeadas que hacen match por SKU (bajajCode). El cruce copia mi
  // peso/dim/margen a ScrapedPart; esto solo deja la traza de origen.
  scrapedMatches ScrapedPart[]      @relation("MatchedScraped")
  supplierPrices SupplierPrice[]
  envioLineas    EnvioLinea[]

  @@index([bajajCode])
}

// Un ENSAMBLE es la página de 99rpm que AGRUPA piezas (un despiece), no un producto: no se
// compra, no se pesa, no tiene precio ni stock, y por eso no vive en `Product`. Lo único que
// tiene es identidad (nombre, moto, de dónde salió) y la lista de piezas que lo componen.
//
// Antes era una fila de `Product` con `isAssembly = true` y arrastraba todas las columnas de
// una pieza sin usar ninguna (1520 ensambles: 0 con peso, medidas, precio, margen, landed,
// código, stock). Compartir la tabla obligaba a cada consulta a recordar `isAssembly`.
//
// Los ids se preservaron de `Product` al migrar (prisma/manual/2026-10-03-ensambles.sql).
//
// No tiene precio a propósito: casi nunca se vende completo — en el armador se destildan
// piezas y se cambian cantidades —, así que el precio de una línea de conjunto se calcula en
// el front sobre las piezas elegidas y se congela en PedidoItem.salePrice.
model Ensamble {
  id               Int      @id @default(autoincrement())
  // El nombre en inglés es el obligatorio: es el que publica 99rpm y la identidad del ensamble.
  // El de español es opcional (una traducción para los presupuestos): si falta, se muestra el
  // inglés — ver nombreEnsamble (lib/linea-pedido.ts).
  nameEs           String?
  nameEn           String
  // UNA moto: esa es la identidad del ensamble, y lo único que distingue dos conjuntos
  // homónimos ("Spark Plugs") de motos distintas. Texto con la etiqueta, igual que en
  // Product.compatibleModels (ver lib/modelo.ts).
  compatibleModels String
  sourceUrl        String?  @unique
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  componentes EnsambleComponente[]
  pedidoItems PedidoItem[]
}

// Una pieza dentro de un ensamble, agrupada por nombre de subgrupo. La misma pieza puede
// aparecer en distintos subgrupos del mismo ensamble (ej: mismo damper en "Brake Pedal" y
// "Rubber Boot"), y también en ensambles distintos.
model EnsambleComponente {
  id         Int      @id @default(autoincrement())
  ensambleId Int
  productId  Int
  quantity   Int      @default(1)
  groupName  String   @default("")
  sortOrder  Int      @default(0)
  ensamble   Ensamble @relation(fields: [ensambleId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([ensambleId, productId, groupName])
  @@index([productId])
}

// Cliente recurrente: entidad maestra para agrupar todos los pedidos de una misma
// persona bajo un solo id (evita fragmentar por typos al tipear el nombre cada vez).
model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  telefono  String?
  notas     String?
  createdAt DateTime @default(now())
  pedidos   Pedido[]
}

model Config {
  key         String   @id
  value       String
  description String?
  // Cuándo se escribió por última vez este valor — cron o mano en /config, cualquiera de
  // los dos. Existe para que una tasa que el cron dejó de actualizar (Heroku Scheduler
  // caído, la API de origen abajo) se note en la UI en vez de venir un precio viejo
  // haciéndose pasar por el del día.
  updatedAt   DateTime @default(now()) @updatedAt
}

// Proveedor alternativo a 99rpm (fuente por defecto). Cada uno puede tener su propio
// precio INR por SKU en SupplierPrice; sin fila ahí, se usa Product.priceInr como base.
model Supplier {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  // País donde está la mercancía ('india' | 'china'). NO decide la ruta ni el costeo del
  // tramo a USA: eso lo decide `inbound` (abajo), porque un proveedor indio puede despachar
  // directo sin pasar por Shoppre (Garuda). Es un hecho fijo del proveedor (no del producto:
  // el mismo SKU puede comprarse en los dos lados), y de acá lo hereda PedidoItem.origen al
  // momento de comprar. Ver lib/inbound.ts y lib/shipping-status.ts.
  origen      String          @default("india")
  // CÓMO llega a USA lo que se le compra. Es un eje DISTINTO de `origen`, y hubo que
  // separarlo porque `origen` estaba haciendo dos trabajos a la vez: dónde está la
  // mercancía y cómo se cotiza el tramo. Garuda Impex rompe esa fusión — está en India
  // igual que Oemship, pero no pasa por Shoppre.
  //
  //   'shoppre'  → la mercancía entra al depósito de Shoppre en India y el tramo lo cobra
  //                la tabla escalón de ShipGlobal sobre el peso cobrable del grupo.
  //   'cotizado' → el proveedor despacha él mismo a la dirección de USA (India Post, un
  //                courier, lo que sea) y pasa UN MONTO PLANO por ese tramo. No hay precio
  //                por kilo que aplicar, así que el número se carga por envío (Envio.tramoUsd).
  //                Es DDP: el proveedor paga los impuestos de salida, así que no queda
  //                nada que sumarle encima — ni seguro de Shoppre ni processing.
  //
  // Un proveedor de China es siempre 'cotizado': ese tramo nunca tuvo tabla (ver
  // lib/inbound.ts, que aplica esa regla en un solo lugar).
  inbound     String          @default("shoppre")
  // FOB propio de este proveedor, en USD por embarque. Es un cargo fijo (no escala con el
  // volumen) y lo cobra CADA proveedor a su manera, así que no puede vivir en Config como
  // un número único. Null ⇒ se usa el default global (cbm_fob_india_usd).
  fobUsd      Decimal?        @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  prices      SupplierPrice[]
  pedidoItems PedidoItem[]
  movimientos Movimiento[]
  envios      Envio[]
}

// Override de precio de un producto para un proveedor puntual, EN USD (a diferencia
// de Product.priceInr que es el precio base de 99rpm, en rupias). Equivale al costo
// "Producto (USD)" del desglose landed: por defecto (isLanded=false) se le siguen
// sumando Shoppre + seguro + marítimo igual que a los productos de 99rpm. Si el
// proveedor ya cotiza puesto en Venezuela (isLanded=true), priceUsd ES el landed final
// y no se le suma nada más encima. Ausencia de fila para un (product, supplier) dado
// ⇒ se usa el precio base (Product.priceInr, vía tasa INR/USD).
model SupplierPrice {
  id         Int      @id @default(autoincrement())
  productId  Int
  supplierId Int
  priceUsd   Decimal  @db.Decimal(10, 2)
  isLanded   Boolean  @default(false)
  // Cantidad MÍNIMA de compra que impone ESTE proveedor para esta pieza ("VEH_DLR Set
  // Qty" en la lista de Bajaj, que es el tamaño de paquete con el que Bajaj despacha a
  // sus concesionarios). Es un piso, no un múltiplo: con mínimo 5 no se puede pedir 3,
  // pero 7 sí. Es un dato del par (producto, proveedor) y no del producto, porque cada
  // distribuidor pone sus condiciones.
  //
  // priceUsd sigue siendo POR PIEZA: el MOQ sube la CANTIDAD que hay que comprar, nunca
  // el precio unitario. Null ⇒ el proveedor no lo declara (distinto de 1, que es "me
  // confirmó que se vende por unidad").
  moq        Int?
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([supplierId])
}

// Una caja física que cruza a Venezuela, comprada a UN proveedor.
//
// El tramo hasta USA se cobra de una de dos maneras, y la decide el proveedor de la caja
// (Supplier.inbound): si la mercancía pasa por el depósito de Shoppre, la tabla escalón de
// ShipGlobal sobre el peso cobrable; si el proveedor despacha por su cuenta —Garuda por
// India Post, DDP— no hay tabla y se carga el total que facturó (tramoUsd). De USA a
// Venezuela el marítimo por ft³ es igual para las dos.
//
// La unidad que se ASIGNA a un envío sigue siendo el PedidoItem y no el Pedido: un
// presupuesto puede estar comprado a medias y repartido entre varias cajas — unas piezas
// a Shoppre y otras a Garuda, cada grupo en su propia caja viajando en paralelo.
model Envio {
  id               Int          @id @default(autoincrement())
  nombre           String?
  notas            String?
  // Cadena logística con la que se costeó ESTA caja: 'aereo' (India → USA en avión →
  // Venezuela) o 'maritimo_cbm' (India → Venezuela directo, tarifa por m³ + FOB fijo).
  // Se elige al crear el envío y no cambia después: re-costear una caja que ya viajó con
  // otra cadena sería inventar un costo. No hay modo global (ver lib/modo.ts). Las filas
  // anteriores a los modos quedan en 'aereo', que es exactamente como se costearon.
  modo             String       @default("aereo")
  // 'borrador'   = todavía se está llenando (solo marítimo: se arma pieza por pieza).
  // 'confirmado' = cerrado, ya viaja. Las cajas anteriores a los borradores nacen acá,
  // que es como estaban: creadas y en curso.
  // 'entregado'  = SOLO marítimo: la caja ya está en mano. Al marcarla se suma cada
  // EnvioLinea a Product.stock en la misma acción (ver recibirEmbarque) — un solo dato,
  // sin transcribirlo a mano en cada producto. El aéreo no usa este valor: ahí "ya está
  // en mi poder" lo dice PedidoItem.shippingStatus === 'entregado' por línea.
  estado           String       @default("confirmado")
  // Cuándo se marcó 'entregado' (ver recibirEmbarque). Null mientras no se marcó, incluso
  // si el envío está viajando hace meses — vacío no es "ya llegó hace mucho", es "todavía
  // no lo marcaste".
  entregadoAt      DateTime?
  // Proveedor al que se le compra ESTA caja. Aplica a las dos rutas.
  //
  // Empezó siendo solo del marítimo, cuando por aire se le compraba siempre a 99rpm. Dejó
  // de ser cierto: hoy conviven una caja de Shoppre y una de Garuda viajando en paralelo,
  // cada una con su propio despacho y su propia factura. La caja ES la compra, así que el
  // proveedor es de la caja y no de cada línea — las líneas que se le asignan lo heredan
  // (ver assignPedido). Null = 99rpm, el precio base en ₹.
  //
  // Se congela al crearla porque decide todo lo demás: el precio de cada pieza, si el
  // tramo a USA lo cobra la tabla de Shoppre o lo factura el proveedor, qué etapas tiene
  // la ruta, y el FOB en el marítimo.
  supplierId       Int?
  shippingCostEst  Decimal?     @db.Decimal(10, 2)
  // El flete real llega en DOS facturas de DOS transportistas distintos: quien cobra el
  // tramo India→USA (Shoppre/ShipGlobal, o lo cotizado) no es quien cobra el tramo
  // USA→Venezuela por mar. Antes de este split había una sola columna, y mezclar los dos
  // montos hacía imposible saber cuál de los dos tramos explicaba una diferencia contra lo
  // calculado — el mensaje de "revisá la tasa, el transportista o el tramo marítimo" tenía
  // que nombrar los tres sospechosos porque no sabía cuál era.
  shippingCostRealAereo    Decimal? @db.Decimal(10, 2)
  shippingCostRealMaritimo Decimal? @db.Decimal(10, 2)
  // ── Los dos montos que nadie puede derivar ───────────────────────────────────────
  // El total que facturó el proveedor por llevar esta caja hasta USA, impuestos incluidos
  // (DDP). Solo tiene sentido cuando despacha él (Supplier.inbound = 'cotizado'): ahí no
  // hay tabla de tarifas que consultar, hay un número que pasó por WhatsApp. Se prorratea
  // entre las piezas igual que lo haría la tabla de ShipGlobal.
  //
  // Esta columna era `inboundChinaUsd` y es literalmente el mismo dato, pero cableado a un
  // solo origen: asumía que el único proveedor sin tabla iba a ser el chino. Garuda Impex
  // —de India, despachando por India Post— lo desmintió, así que se renombró en vez de
  // agregar una segunda columna que significara lo mismo.
  tramoUsd         Decimal?     @db.Decimal(10, 2)
  // Lo que costó la transferencia con la que se le pagó al proveedor de esta caja. Son DOS
  // montos porque un giro internacional se cobra en las dos puntas, y no son el mismo dato:
  //
  //   comisionSalienteUsd → lo que MI banco me descuenta por emitir la transferencia. Se
  //                         sabe el mismo día, mirando el estado de cuenta.
  //   comisionEntranteUsd → lo que el corresponsal y el banco DE ÉL le descuentan al
  //                         acreditar. No aparece en mi cuenta: aparece en que el proveedor
  //                         dice que recibió menos que lo facturado y hay que completarle la
  //                         diferencia. Es costo mío igual, solo que me entero después.
  //
  // Estaban sumadas en una sola columna (`comisionUsd`) y eso obligaba a inventar la
  // segunda para poder anotar la primera — y como acá vacío ≠ cero, ese invento entraba
  // derecho al landed que define los precios de venta.
  //
  // Se anotan, no se calculan, y no hay ninguna regla guardada en Supplier a propósito: la
  // comisión no es un rasgo del proveedor sino de cada giro — solo a algunos se les
  // transfiere y el banco cobra distinto cada vez. Un porcentaje guardado habría producido
  // un número inventado con apariencia de dato.
  //
  // Null ⇒ no se cargó, que NO es cero: cero es "esa punta no cobró nada" y es un dato
  // distinto. Las pantallas muestran "sin cargar" para el primero.
  comisionSalienteUsd Decimal?  @db.Decimal(10, 2)
  comisionEntranteUsd Decimal?  @db.Decimal(10, 2)
  // ── La caja como la pesó y midió el transportista ────────────────────────────────
  // El catálogo guarda la pieza DESNUDA; lo que se factura es el BULTO: cada repuesto con
  // su caja o bolsa, el cartón exterior y el relleno. Son dos cosas distintas y la
  // diferencia no es chica — contra el envío real 64898 fue +19% de peso y +56% de
  // volumen sobre la suma de las piezas, y ese error se paga dos veces (el escalón de
  // ShipGlobal y el ft³ del tramo Miami→CCS).
  //
  // Mientras estos campos estén vacíos, el costeo de la caja es un PISO y no una
  // estimación: sumar piezas sueltas nunca puede sobreestimar, solo subestimar. Cuando se
  // cargan, mandan ellos — y de paso dejan medido el factor de empaque real de la caja.
  pesoRealKg       Decimal?     @db.Decimal(8, 3)
  cajaL            Float?
  cajaA            Float?
  cajaH            Float?
  // Carga COMERCIAL: piezas que ya se le vendieron a alguien. Es el carril aéreo.
  items            PedidoItem[]
  // Carga PROPIA: mercancía que traigo para stock. Es el carril marítimo.
  lineas           EnvioLinea[]
  movimientos      Movimiento[]
  supplier         Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([supplierId])
}

// Una línea de mercancía PROPIA dentro de un embarque.
//
// No es un PedidoItem y no debe serlo: PedidoItem es una línea COMERCIAL — tiene precio de
// venta, cliente detrás y a veces un adelanto cobrado. Lo que traigo para stock no le fue
// prometido a nadie, así que no tiene precio que congelar (cuando llega, su precio de venta
// sale del catálogo como el de cualquier pieza). Meterlo en un Pedido obligaba a inventar
// un cliente y un precio, y ese precio quedaba viejo apenas cambiaba la tarifa.
//
// Por eso también no lleva estado de transporte propio: el embarque marítimo viaja entero,
// como una sola caja, a diferencia del aéreo donde cada ítem puede ir por su lado.
model EnvioLinea {
  id        Int      @id @default(autoincrement())
  envioId   Int
  productId Int
  quantity  Int      @default(1)
  notas     String?
  createdAt DateTime @default(now())

  envio   Envio   @relation(fields: [envioId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([envioId, productId])
  @@index([envioId])
}

model Pedido {
  id            Int          @id @default(autoincrement())
  clientName    String
  notas         String?
  // 'cliente' = pedido de un cliente (requiere aprobación + adelanto).
  // 'propio'  = stock que traigo para revender por mi cuenta (sin cliente ni adelanto).
  tipo          String       @default("cliente")
  status        String       @default("presupuesto")
  // Adelanto: se llenan al aprobar un presupuesto de cliente (ver aprobarPedido). Desde el
  // libro de movimientos, depositUsd es una CACHÉ de "total recibido hasta ahora" — la
  // mantiene aprobarPedido/registrarPagoPedido creando un Movimiento por cada aumento (el
  // delta), nunca sobreescribiendo a ciegas. Así todo lo que ya lee depositUsd (clienteTotales,
  // cobranzaEnvio) sigue funcionando sin cambios, y el libro queda como la fuente de verdad.
  depositUsd    Decimal?     @db.Decimal(10, 2)
  paymentMethod String?
  depositAt     DateTime?
  // La etapa física ya NO vive acá: bajó a PedidoItem, porque un presupuesto puede
  // estar comprado a medias y repartido entre proveedores y cajas distintas. El estado
  // del pedido se deriva de sus ítems con stageSummary (ver lib/shipping-status.ts).
  // clientName queda como snapshot denormalizado (lo fija el server action desde
  // cliente.nombre); clienteId es la relación real para agrupar el historial.
  clienteId     Int?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  items         PedidoItem[]
  movimientos   Movimiento[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PedidoItem {
  id          Int     @id @default(autoincrement())
  pedidoId    Int
  // Una línea es una pieza O un conjunto, nunca las dos (CHECK PedidoItem_pieza_xor_conjunto,
  // que Prisma no modela y vive solo en el SQL): `productId` para una pieza suelta,
  // `ensambleId` para un conjunto.
  productId   Int?
  ensambleId  Int?
  quantity    Int     @default(1)
  salePrice   Decimal @db.Decimal(10, 2)
  // Un conjunto vendido a precio único guarda el snapshot de las piezas elegidas:
  // [{ nameEs, bajajCode, quantity }]. Null = pieza suelta. El CHECK
  // PedidoItem_conjunto_lleva_piezas lo ata a ensambleId: hay snapshot si y solo si hay conjunto.
  bundleItems Json?

  // ── Eje logístico ──────────────────────────────────────────────────────────
  // Vivía en Pedido, pero la unidad real de compra es la LÍNEA: de un mismo
  // presupuesto unas piezas se compran en India y otras en China, en momentos
  // distintos y viajando en cajas distintas. El estado del Pedido pasa a ser
  // derivado (la etapa más atrasada de sus ítems), ver pedidoStageSummary.
  envioId          Int?
  shippingStatus   String    @default("pendiente")
  shippingStatusAt DateTime?
  // Proveedor al que se le compró de verdad esta línea. Null ⇒ base 99rpm (India).
  supplierId       Int?
  // Snapshot de Supplier.origen al comprar: congela la ruta aunque el proveedor cambie.
  origen           String    @default("india")
  // Snapshot de Supplier.inbound: cómo llegó a USA esta línea. Hace falta guardarlo
  // aparte de `origen` porque dos proveedores del mismo país pueden entrar por vías
  // distintas — Oemship por Shoppre, Garuda por India Post — y de esto depende tanto el
  // costeo del tramo como las etapas que tiene la ruta (un 'cotizado' nunca pasa por
  // Shoppre). Las 104 líneas anteriores a Garuda son todas de 99rpm/Shoppre, que es
  // justamente el default.
  inbound          String    @default("shoppre")
  // Snapshot de SupplierPrice.isLanded: el proveedor cotizó puesto en Venezuela, así
  // que la pieza NO viaja en la caja — no suma peso ni volumen al envío y salta
  // directo a 'en_venezuela'. Nunca se infiere del monto; sale de la fila explícita.
  isLanded         Boolean   @default(false)
  // Lo que se pagó realmente por la línea (contraste contra el landed estimado).
  costRealUsd      Decimal?  @db.Decimal(10, 2)
  compradoAt       DateTime?

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  ensamble Ensamble? @relation(fields: [ensambleId], references: [id], onDelete: Restrict)
  envio    Envio?    @relation(fields: [envioId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([pedidoId, productId])
  @@unique([pedidoId, ensambleId])
  @@index([envioId])
  @@index([shippingStatus])
}

// Libro de movimientos: la fuente única de "cuánta plata tengo". Registra ingresos y
// egresos reales de la empresa, en USD — no estimaciones ni montos facturados (esos ya
// viven en Envio/PedidoItem/SupplierPrice). `categoria` fija `tipo` (ver
// lib/movimientos.ts: tipoDeCategoria) así que no hay forma de anotar un ingreso con
// categoría de egreso o viceversa.
//
// Los tres links son opcionales y ninguno excluye a los otros: un pago a un proveedor
// puede ir atado a la caja (envioId) y al proveedor (supplierId) a la vez; un gasto
// operativo (alquiler, etc.) no va atado a nada.
//
// `Pedido.depositUsd` sigue siendo lo que leen las pantallas de cobranza — este modelo lo
// alimenta (ver aprobarPedido/registrarPagoPedido) en vez de reemplazarlo, para no tener
// que reescribir cobranzaEnvio/clienteTotales.
model Movimiento {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  tipo        String
  categoria   String
  monto       Decimal  @db.Decimal(10, 2)
  metodoPago  String?
  descripcion String?
  pedidoId    Int?
  envioId     Int?
  supplierId  Int?
  createdAt   DateTime @default(now())

  pedido   Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  envio    Envio?    @relation(fields: [envioId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([pedidoId])
  @@index([envioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogo MAESTRO, armado desde el scrape de 99rpm.com. Espeja la estructura del
// sitio en tres niveles:
//   MotoModel (enum) → ScrapedProduct (ENSAMBLE/bundle) → ScrapedGroup (SUBGRUPO) → ScrapedPart (PARTE/SKU)
// El scrape es la fuente de verdad de la estructura, nombre (inglés) y precio INR.
// El peso y las dimensiones (datos físicos que aporto yo) se CRUZAN por SKU y se copian
// sobre ScrapedPart cuando su sku coincide con un Product.bajajCode que ya tengo curado
// (ver scripts/cross-ref.ts, re-ejecutable). El margen NO se cruza: tiene default global
// en Config (default_margin) y es editable por parte. Cada página de 99rpm es de UN modelo,
// así que ScrapedProduct.model es un campo directo (enum). La compatibilidad
// cruzada sale de que un mismo SKU aparece en productos de varios modelos.
// ─────────────────────────────────────────────────────────────────────────────

enum MotoModel {
  PULSAR_N250_USD_FORK_2024_25 // vehicle_type 595
  PULSAR_N250_DUAL_ABS_2022_23 // 579
  PULSAR_N250_SINGLE_ABS_2021_23 // 562
  PULSAR_NS200_USD_FORK_2023 // 580
  PULSAR_NS200_BS6_2021_23 // 557
  PULSAR_NS200_BS6_2020 // 558
  PULSAR_NS200_BS4_2017_19 // 497
  PULSAR_200NS_BS3_2012_16 // 442
  PULSAR_N160_SINGLE_ABS_2022_23 // 572
  PULSAR_N160_DUAL_ABS_2022_23 // 574
  PULSAR_180_BS4_2017_19 // 513
  PULSAR_180_BS3_2009_16_UG4 // 539
  PULSAR_150_BS4 // 515
  PULSAR_150_UG4 // 449
  // Única no-Pulsar del catálogo: otra familia (commuter). Entró después del enum original
  // y ya existe en la DB con 81 ensambles scrapeados, así que declararla acá es lo que evita
  // que una migración futura recree el tipo sin este valor y falle contra esas filas.
  BOXER_BM150 // 596
}

// ENSAMBLE: una página de producto de 99rpm = un bundle Magento (con subgrupos).
model ScrapedProduct {
  id           Int       @id @default(autoincrement())
  sourceUrl    String    @unique
  slug         String    @unique
  title        String
  model        MotoModel // moto compatible (cada página de 99rpm = un modelo)
  mainImageUrl String? // URL original de la imagen en 99rpm (con marca de agua)
  imageS3Key   String? // key de la imagen limpia en Supabase Storage
  imageS3Url   String?
  totalInr     Int? // suma de precios de los componentes (total del bundle)
  rawJson      Json // bundle parseado completo, por seguridad/reproceso
  scrapedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  groups ScrapedGroup[]

  @@index([model])
}

// SUBGRUPO: cada opción/grupo Magento dentro del ensamble (ej. "Front Suspension").
model ScrapedGroup {
  id        Int    @id @default(autoincrement())
  productId Int
  rawTitle  String // título crudo de Magento (ej. "Center Belly Pan| unpainted black")
  title     String // título limpio (ej. "Center Belly Pan")
  sortOrder Int    @default(0)

  product ScrapedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  parts   ScrapedPart[]

  @@index([productId])
}

// PARTE: un componente/SKU dentro de un subgrupo. Datos del scrape + peso/dim curados
// (copiados por cruce de SKU desde mi Product.bajajCode). El margen es override por
// parte: null ⇒ usa el default global de Config (default_margin).
model ScrapedPart {
  id           Int     @id @default(autoincrement())
  groupId      Int
  name         String // nombre de la pieza (inglés, del scrape)
  sku          String // código Bajaj primario
  altSku       String? // código alterno si el nombre trae dos
  priceInr     Int // precio India del scrape
  qty          Int     @default(1)
  sortOrder    Int     @default(0)
  imageUrl     String? // imagen específica del componente si existe
  imageS3Key   String?
  // 99rpm rotula la pieza como "(Discontinued/Supply-Disruption/NLS)" en el label de su
  // selección. Booleano y no fecha: esta tabla es el espejo del último scrape, se reescribe
  // entera, y lo que interesa es qué decía la página esa vez. La fecha vive en Product.
  discontinued Boolean @default(false)

  // ── peso/dim: se llenan por cruce de SKU (scripts/cross-ref.ts) ──
  weightGrams      Int?
  dimL             Float?
  dimA             Float?
  dimH             Float?
  matchedProductId Int? // Product del que salió el peso/dim (traza del cruce)
  // margen override por parte; null ⇒ default global de Config (default_margin)
  margin           Float?

  group   ScrapedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  matched Product?     @relation("MatchedScraped", fields: [matchedProductId], references: [id], onDelete: SetNull)

  @@index([sku])
  @@index([groupId])
  @@index([matchedProductId])
}
