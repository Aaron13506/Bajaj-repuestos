# /etc/bajaj/backup.env — lo lee bajaj-backup.service (después de app.env, así que ya
# tiene DATABASE_URL). Comillas simples, igual que app.env.

# El remoto de rclone se define entero por entorno: no hace falta un rclone.conf.
# Lightsail Object Storage habla S3. Las access keys de un bucket no pueden listar ni
# crear buckets, por eso NO_CHECK_BUCKET.
RCLONE_CONFIG_BACKUP_TYPE='s3'
RCLONE_CONFIG_BACKUP_PROVIDER='AWS'
RCLONE_CONFIG_BACKUP_REGION='us-east-1'
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=''
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=''
RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET='true'

# <remoto>:<bucket>[/carpeta]. Es lo único que backup.sh necesita saber del destino.
BACKUP_REMOTE='backup:motokira-backups'

# Opcionales (estos son los valores por defecto).
#BACKUP_DIR='/var/backups/bajaj'
#BACKUP_KEEP_LOCAL='14'          # dumps que se conservan en el disco de la máquina
#BACKUP_REMOTE_MAX_AGE='60d'     # en el bucket se borra lo más viejo que esto
