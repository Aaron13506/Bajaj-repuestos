# /etc/bajaj/oauth2-proxy.env — solo root lo lee (systemd, antes de bajar privilegios).
# Lo no secreto vive en oauth2-proxy.cfg, versionado. Comillas simples, igual que app.env.

# De console.cloud.google.com → Credentials → OAuth client ID (Web application).
OAUTH2_PROXY_CLIENT_ID=''
OAUTH2_PROXY_CLIENT_SECRET=''

# 32 bytes en base64 url-safe:  openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=''

# Tiene que ser EXACTAMENTE una de las "Authorized redirect URIs" del cliente de Google.
OAUTH2_PROXY_REDIRECT_URL='https://motokira.TAILNET.ts.net/oauth2/callback'
