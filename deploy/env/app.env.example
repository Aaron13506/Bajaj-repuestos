# /etc/bajaj/app.env — lo leen la app y el cron de tasas (systemd EnvironmentFile) y,
# a través de ~/.profile, la sesión del usuario `bajaj` (psql, pnpm check:*, deploy.sh).
#
# Formato: KEY='valor', siempre entre comillas SIMPLES. systemd y bash las leen igual y
# ninguno expande nada adentro, así que un `$` o un `\` en una clave no se rompe. Por eso
# la clave no puede llevar una comilla simple.
#
# NO definir APP_ENV: es el interruptor que habilita admin/admin123 en proxy.ts. Sin él, si
# falta ADMIN_USER o ADMIN_PASSWORD el sitio responde 503 en vez de abrirse.

# La clave del rol `bajaj` es la DB_PASSWORD que se le pasó a setup.sh. Solo letras y
# números (por ejemplo `openssl rand -hex 24`): va dentro de una URL y un `@` o un `/` la
# parte. El host es localhost: lib/db.ts no usa TLS ahí.
DATABASE_URL='postgresql://bajaj:CLAVE_DE_LA_BASE@localhost:5432/bajaj_repuestos'
DIRECT_URL='postgresql://bajaj:CLAVE_DE_LA_BASE@localhost:5432/bajaj_repuestos'

# Basic Auth de proxy.ts: segunda capa, detrás del Google de oauth2-proxy.
ADMIN_USER='CAMBIAR'
ADMIN_PASSWORD='CAMBIAR_POR_UNA_CLAVE_LARGA'

# Imágenes (solo las usan los scripts de imágenes, no las páginas). Hasta la fase 6 son
# las de Supabase; después, las del bucket de Lightsail.
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''
S3_BUCKET_NAME=''
S3_ENDPOINT_URL=''
S3_REGION=''
